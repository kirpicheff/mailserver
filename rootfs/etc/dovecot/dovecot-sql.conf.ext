# SQL аутентификация и выборка пользователей для Dovecot 2.4

sql_driver = mysql

mysql localhost {
  dbname = postfix
  user = {{ MARIADB_USER }}
  password = {{ MARIADB_PASS }}
}

auth_allow_weak_schemes = yes

passdb sql {
  default_password_scheme = MD5-CRYPT
  query = \
    SELECT username AS user, \
      CASE \
        WHEN password LIKE '$6$%' THEN CONCAT('{SHA512-CRYPT}', password) \
        WHEN password LIKE '$1$%' THEN CONCAT('{MD5-CRYPT}', password) \
        ELSE password \
      END AS password, \
      '/data/mail/%{user | domain}/%{user | username}' AS userdb_home, \
      '/data/mail/%{user | domain}/%{user | username}' AS userdb_mail_path, \
      1000 AS userdb_uid, \
      1000 AS userdb_gid \
    FROM mailbox WHERE username = '%{user}' AND active = '1'
}

userdb sql {
  iterate_query = SELECT username AS user FROM mailbox
  query = \
    SELECT '/data/mail/%{user | domain}/%{user | username}' AS home, \
      '/data/mail/%{user | domain}/%{user | username}' AS mail_path, \
      1000 AS uid, 1000 AS gid, \
      CONCAT(quota, 'B') AS quota_storage_size \
    FROM mailbox WHERE username = '%{user}' AND active = '1'
}
