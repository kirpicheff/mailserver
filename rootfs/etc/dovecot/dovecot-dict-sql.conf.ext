connect = host=localhost dbname=postfix user={{ MARIADB_USER }} password={{ MARIADB_PASS }}

map {
  pattern = priv/quota/storage
  table = quota2
  username_field = username
  value_field = bytes
}
map {
  pattern = priv/quota/messages
  table = quota2
  username_field = username
  value_field = messages
}
