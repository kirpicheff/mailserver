user = {{ MARIADB_USER }}
password = {{ MARIADB_PASS }}
hosts = localhost
dbname = postfix
query = SELECT goto FROM alias WHERE address='%s' AND active = '1' UNION SELECT GROUP_CONCAT(CASE WHEN active='1' THEN username ELSE NULL END separator ', ')  FROM mailbox  WHERE DOMAIN='%d' AND '%s'='all@%d'

